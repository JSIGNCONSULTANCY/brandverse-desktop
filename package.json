{
  "name": "brandverse-books",
  "productName": "BrandVerse Books",
  "version": "1.0.0",
  "description": "BrandVerse Books + Payroll - accounting software (desktop edition)",
  "author": "J Sign Consultancy",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win nsis",
    "dist:dir": "npm run prepare-app && electron-builder --win dir",
    "configure-licensing": "node scripts/configure-licensing.js"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "@fontsource/noto-naskh-arabic": "^5.1.0",
    "@fontsource/urbanist": "^5.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jsign.brandversegold",
    "productName": "BrandVerse Books",
    "copyright": "J Sign Consultancy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup/**",
      "license/**",
      "license.config.json",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BrandVerse Gold",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}